{
  "name": "vibe-enigma",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A settable web Enigma I that decodes the DevFest Vibe Lounge feed",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "check": "npm run lint && npm run test && npm run build",
    "selftest": "node --experimental-strip-types scripts/selftest.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.6.6",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
